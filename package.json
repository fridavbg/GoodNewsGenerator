{
  "name": "good-news",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "scripts": {
    "postinstall": "npm run build -w @goodnews/shared",
    "dev": "concurrently -n shared,api,web -c blue,green,magenta \"npm run dev -w @goodnews/shared\" \"npm run dev -w backend\" \"npm run dev -w frontend\""
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "concurrently": "^10.0.5"
  },
  "overrides": {
    "typescript": "^5.9.3"
  }
}
